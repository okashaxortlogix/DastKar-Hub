# ==============================================================================
# DASTKAR HUB — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Core
APP_NAME="DastKar Hub"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://dastkarhub.pk

# Logging & Monitoring
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dastkar_hub
DB_USERNAME=dastkar_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_SECRET

# Cache, Sessions & Queues (Redis)
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_SECRET
REDIS_PORT=6379

# Object Storage (AWS S3 / Cloudflare R2 / MinIO for artisan photography & verifications)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_S3_OR_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_S3_OR_R2_SECRET_KEY
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=dastkar-media-production
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://cdn.dastkarhub.pk

# Mail Service (Transactional notifications for buyers & sellers)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.dastkarhub.pk
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@dastkarhub.pk"
MAIL_FROM_NAME="DastKar Hub Craft Marketplace"

# ------------------------------------------------------------------------------
# PAKISTANI PAYMENTS GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
# JazzCash Merchant Credentials
JAZZCASH_MERCHANT_ID=MC_LIVE_MERCHANT_ID
JAZZCASH_PASSWORD=YOUR_JAZZCASH_PASSWORD
JAZZCASH_INTEGRITY_SALT=YOUR_JAZZCASH_HMAC_INTEGRITY_SALT
JAZZCASH_RETURN_URL=https://dastkarhub.pk/api/v1/webhooks/payment/jazzcash

# Easypaisa Merchant Credentials
EASYPAISA_STORE_ID=EP_STORE_ID_LIVE
EASYPAISA_HASH_KEY=YOUR_EASYPAISA_HASH_KEY

# Card Processing (1Link PayPak / Visa / Mastercard 3D Secure)
CARD_PAYMENT_GATEWAY_KEY=YOUR_PAYMENT_GATEWAY_LIVE_KEY
CARD_PAYMENT_GATEWAY_SECRET=YOUR_PAYMENT_GATEWAY_LIVE_SECRET

# ------------------------------------------------------------------------------
# PAKISTANI LOGISTICS & COURIER PARTNERS
# ------------------------------------------------------------------------------
# TCS Express Courier
TCS_API_KEY=YOUR_TCS_LIVE_API_KEY
TCS_COST_CENTER=CC-KHI-01
TCS_ORIGIN_CITY=Karachi

# Trax Logistics
TRAX_API_KEY=YOUR_TRAX_API_KEY
TRAX_PICKUP_ID=PKR_PICKUP_101
TRAX_WEBHOOK_SECRET=YOUR_TRAX_WEBHOOK_HMAC_SECRET

# Platform Commission Settings (Standard Pakistani Craft Economics)
PLATFORM_COMMISSION_PERCENTAGE=8.00
